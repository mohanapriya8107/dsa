#include<stdio.h>
int main(){
    char str[100];
    scanf("%s",str);
    for(int i=0;str[i]!='\0';i++){
        if(str[i]>='0'&& str[i]<='9'){
            int d=str[i]-'0';
            for(int j=1;j<d;j++){
                printf("%c",str[i-1]);
            }
        }

        else{
            printf("%c",str[i]);
        }
    }
    return 0;
}
